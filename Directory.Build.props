<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>paragon-stats contributors</Authors>
    <Copyright>Copyright (c) 2026 paragon-stats contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Version is derived from git tags by MinVer (tags look like v0.1.0). The release
    workflow (shared release action, python-semantic-release, tag-only) owns the tags;
    MinVer stamps the assembly/file/AOT version. Each feature is a minor (feat: -> minor),
    so between tags MinVer auto-increments the minor: the next dev build reads
    X.(Y+1).0-alpha, tracking the upcoming release.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- StyleCop settings (usings outside namespaces, per docs/style-guides/csharp.md). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!--
    PS0001, the in-repo minimum-identifier-length rule, loads into every other
    project's compile (see docs/style-guides/csharp.md, #234). It excludes
    itself, which would be circular.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ParagonStats.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\ParagonStats.Analyzers\ParagonStats.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
