#!/bin/sh
# shellcheck source=/dev/null  # husky.sh is generated in .husky/_/ at install time
. "$(dirname "$0")/_/husky.sh"

# Husky stops at the first failing check, so task-runner.json lists the quickest
# first. --quiet drops Husky's banner and separator lines; run the same line
# without it to see them. The hook restores no tools; the bootstrap script does
# that once per clone (CONTRIBUTING.md).
dotnet husky run --quiet --group pre-commit
