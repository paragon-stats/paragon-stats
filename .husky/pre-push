#!/bin/sh
# shellcheck source=/dev/null  # husky.sh is generated in .husky/_/ at install time
. "$(dirname "$0")/_/husky.sh"

# Git sends the refs it would update on stdin, one per line, and sends nothing
# at all when there is nothing to push. Read it once into a variable rather than
# consuming it in a pipeline, which is what the homelab repositories' composed
# pre-push does, and decide from it: an up-to-date push otherwise pays for a
# build, a test run and a linter container to be told the remote already
# matches.
REFS="$(cat)"
[ -n "$REFS" ] || exit 0

# A deletion carries an all-zero local sha and pushes no content to verify.
# pre-commit's own pre-push handler skips those refs the same way before
# deciding it has nothing to do. Anything else - including a line this cannot
# make sense of - runs the gate: the cost of a needless run is minutes, and the
# cost of a skipped one is an unverified push.
#
# The loop reads from a here-document, not a pipe, so the flag it sets survives:
# a piped `while read` runs in a subshell and the assignment is lost.
has_content=
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -n "$local_sha" ] || continue
    case "$local_sha" in
    *[!0]*) has_content=1 ;;
    esac
done <<REFS_EOF
$REFS
REFS_EOF
[ -n "$has_content" ] || exit 0

# Super-Linter runs here rather than pre-commit so it lints the same thing CI
# does. With RUN_LOCAL it diffs against origin/main using committed history, so
# in pre-commit it never saw the staged files - it linted the previous commit
# and reported a pass on code nobody had checked. At push time HEAD contains the
# commits, and the range matches the CI workflow's exactly.
dotnet husky run --group pre-push
